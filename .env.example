# Execução do backend
NODE_ENV=development
PORT=3001
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco: omita para SQLite local; use PostgreSQL em nuvem quando necessário
# DATABASE_URL=postgresql://usuario:senha@host:5432/geomind
# GEOMIND_DATA_DIR=./data

# Armazenamento local de evidências
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
MAX_SPREADSHEET_BYTES=26214400
BACKUP_RETENTION_DAYS=30

# IA server-side; nunca use VITE_ para chaves privadas
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROMPT_VERSION=image-description-v1

# Google Maps Platform server-side
# GOOGLE_MAPS_API_KEY=

# Métricas; configure para exigir o header X-Metrics-Token
# METRICS_TOKEN=

# Gateway local opcional para dados internos/espelhados
# LOCAL_GATEWAY_URL=http://127.0.0.1:4010
# SYNC_TARGET_URL=http://127.0.0.1:4010
# SYNC_SHARED_SECRET=gere-um-segredo-compartilhado-com-o-gateway

# Billing: none bloqueia operações financeiras; local apenas para desenvolvimento
BILLING_PROVIDER=none
# BILLING_PROVIDER=stripe
# BILLING_WEBHOOK_SECRET=

# Frontend: informe a origem do backend, sem acrescentar /api/v1
VITE_API_BASE_URL=http://localhost:3001
