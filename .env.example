# =============================================================
# GeoMind Full — Exemplo de variáveis de ambiente (.env)
# Produção: configure esses valores no Render Environment Group
#            ou em Secrets Manager / Docker secrets.
# =============================================================

# --- Execução do backend -------------------------------------
# OBRIGATÓRIO em produção: production
NODE_ENV=production
PORT=3001

# OBRIGATÓRIO em produção — mínimo 64 caracteres hex (ex: openssl rand -hex 32)
# Nunca use o valor padrão em produção.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# OBRIGATÓRIO em produção — lista EXPLÍCITA de origens, sem wildcard
# Quando CORS credentials=true (HttpOnly cookie), NÃO use "*".
# Ex: https://seu-dominio.com.br,https://app.seu-dominio.com.br
ALLOWED_ORIGINS=https://geomind-frontend.onrender.com

# --- Banco de dados ------------------------------------------
# OBRIGATÓRIO em produção (PostgreSQL).
# Omita para SQLite local apenas em desenvolvimento / CI.
DATABASE_URL=postgresql://usuario:senha@endereco:5432/geomind
DB_POOL_MAX=20
# GEOMIND_DATA_DIR=./data

# --- Armazenamento persistente -------------------------------
STORAGE_DIR=/app/storage
MAX_UPLOAD_BYTES=10485760
MAX_SPREADSHEET_BYTES=26214400
BACKUP_RETENTION_DAYS=30

# --- IA server-side (nunca use VITE_ para chaves privadas) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROMPT_VERSION=image-description-v1

# --- Google Maps Platform server-side ------------------------
GOOGLE_MAPS_API_KEY=

# --- Métricas Prometheus -------------------------------------
# OBRIGATÓRIO em produção para proteger o /metrics.
# Header exigido: X-Metrics-Token
METRICS_TOKEN=gere-um-segredo-aleatorio-para-metricas

# --- Gateway / sincronia interna opcional --------------------
# LOCAL_GATEWAY_URL=http://127.0.0.1:4010
# SYNC_TARGET_URL=http://127.0.0.1:4010
# SYNC_SHARED_SECRET=gere-um-segredo-compartilhado-com-o-gateway

# --- Billing -------------------------------------------------
# Valores permitidos: none | local | stripe
#   none  → bloqueia operações de compra de créditos
#   local → permitido SOMENTE em NODE_ENV != production
#   stripe→ exige BILLING_WEBHOOK_SECRET e chaves Stripe
BILLING_PROVIDER=none
# BILLING_PROVIDER=stripe
# BILLING_WEBHOOK_SECRET=

# --- Frontend (variáveis expostas no bundle) -----------------
# IMPORTANTE: deve apontar para a ORIGEM do backend, SEM /api/v1
VITE_API_BASE_URL=https://geomind-api.onrender.com
VITE_BACKEND_URL=https://geomind-api.onrender.com
